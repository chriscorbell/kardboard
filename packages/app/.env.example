# Server
PORT=3070
KARDBOARD_DATA_DIR=./data
KARDBOARD_PUBLIC_URL=http://localhost:5173

# Auth: "dev" signs every request in as the seeded admin. "clerk" verifies Clerk session tokens.
# With NODE_ENV=production the app refuses to start in dev mode, except in a Preview container.
KARDBOARD_AUTH=dev
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Email (Resend). Leave empty to log emails to stdout instead of sending.
RESEND_API_KEY=
KARDBOARD_EMAIL_FROM="Milo <milo@example.com>"

# Daily SQLite snapshot (docs/runbooks/backups.md). A negative hour turns it off.
KARDBOARD_BACKUP_HOUR=4
KARDBOARD_BACKUP_KEEP=14
# A directory off the data disk that each snapshot, and every new attachment, is copied to, pruned
# to the same count. Empty copies nothing. Production uses a NAS mount.
KARDBOARD_BACKUP_COPY_DIR=

# Runner service. Leave empty to run sessions in "noop" mode (records only).
KARDBOARD_RUNNER_URL=
KARDBOARD_RUNNER_TOKEN=

# Runner-hosted previews. The secret signs the cookie the preview router checks; the domain and
# pattern make a card's hostname. Empty domain means it is taken from KARDBOARD_PUBLIC_URL.
KARDBOARD_PREVIEW_SECRET=
KARDBOARD_PREVIEW_DOMAIN=
KARDBOARD_PREVIEW_HOST_PATTERN={card}.{domain}

# Client (Vite reads VITE_* at build time)
VITE_CLERK_PUBLISHABLE_KEY=

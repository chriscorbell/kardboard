# Server
PORT=3070
KARDBOARD_DATA_DIR=./data

# Daily SQLite snapshot (docs/runbooks/backups.md). A negative hour turns it off.
KARDBOARD_BACKUP_HOUR=4
KARDBOARD_BACKUP_KEEP=14
# A directory off the data disk that each snapshot, and every new attachment, is copied to, pruned
# to the same count. It must hold a file named .kardboard-backup-target, or the copy refuses. Empty
# copies nothing. Production uses a NAS mount.
KARDBOARD_BACKUP_COPY_DIR=

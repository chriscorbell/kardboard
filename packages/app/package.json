{
  "name": "@kardboard/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "node --import tsx --test server/test/*.test.ts client/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.client-test.json",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx server/src/seed.ts"
  },
  "dependencies": {
    "@kardboard/shared": "workspace:*",
    "@clerk/backend": "^2.7.0",
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.5.0",
    "@libsql/client": "^0.15.9",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.11",
    "nanoid": "^5.1.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@clerk/react": "^6.15.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@tailwindcss/vite": "^4.1.10",
    "@tanstack/react-query": "^5.80.7",
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.1",
    "lucide-react": "^0.515.0",
    "motion": "^12.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.10",
    "tsx": "^4.20.3",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  }
}

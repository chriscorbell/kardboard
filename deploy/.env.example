KARDBOARD_ADMIN_EMAIL=hi@chriscorbell.com
# Production instance keys from dashboard.clerk.com
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
RESEND_API_KEY=
# openssl rand -base64 32. Guards the runner's API and the egress proxy's /limits route, which the
# app reads to decide a provider fallback; Session containers never hold it.
KARDBOARD_RUNNER_TOKEN=
# openssl rand -base64 32. Signs Preview cookies; the app issues them and the preview router
# verifies them. Rotating it signs every open Preview session out.
KARDBOARD_PREVIEW_SECRET=
# Preview hostname shape; `{card}` is the card's short id and `{domain}` the app's parent domain.
# First-level names fit Universal SSL: k6u39mjg.kardboard.cc. Route `*.kardboard.cc`
# to the preview router, after the explicit `kardboard.cc` route.
KARDBOARD_PREVIEW_HOST_PATTERN={card}.{domain}
# claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
# Codex: sign in with `codex login` and copy ~/.codex/auth.json to the host path below. Give the
# absolute host path, which the runner needs for a bind mount; the egress proxy reads the same file
# through its own /secrets mount. Leave empty and Codex Sessions are refused rather than started.
# Session containers run as uid 1001 and the egress proxy as uid 1000, so on the host run
#   chown 1000:1001 <file> && chmod 640 <file>
KARDBOARD_CODEX_AUTH_FILE=
# Set to 1 to keep the Codex credential in the egress proxy instead of inside Session containers.
# Verified against the real ChatGPT backend on 2026-09-15 and the production setting; see
# docs/adr/0002. Leave it empty and Codex traffic skips the proxy, so a Codex usage limit cannot be
# seen and provider fallback should be turned off in the admin panel.
KARDBOARD_CODEX_VIA_EGRESS=
# GitHub Apps (see deploy/github-apps.md). Keys are base64 of the downloaded PEM; use deploy/add-github-key.sh.
GITHUB_SESSIONS_APP_ID=
GITHUB_SESSIONS_APP_SLUG=kardboard-sessions
GITHUB_SESSIONS_APP_PRIVATE_KEY_B64=
GITHUB_MERGE_APP_ID=
GITHUB_MERGE_APP_SLUG=kardboard-merge
GITHUB_MERGE_APP_PRIVATE_KEY_B64=
